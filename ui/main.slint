import { Button, CheckBox, LineEdit } from "std-widgets.slint";

component IconButton inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 42px; height: 42px; border-radius: 21px;
    background: touch.pressed ? #d5d5d5 : #eeeeee;
    Text { text: root.icon; font-size: 23px; horizontal-alignment: center; vertical-alignment: center; color: #666666; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    title: "Kimaier"; min-width: 200px; min-height: 320px; preferred-width: 212px; preferred-height: 340px;
    in-out property <int> page: 0;
    in-out property <bool> running: false;
    in-out property <string> elapsed: "00:00:00";
    in-out property <string> status: "";
    in-out property <string> api-url: "";
    in-out property <string> api-token: "";
    in-out property <string> project: "";
    in-out property <string> activity: "";
    in-out property <string> week-hours: "";
    in-out property <string> work-start: "";
    in-out property <bool> monday; in-out property <bool> tuesday; in-out property <bool> wednesday;
    in-out property <bool> thursday; in-out property <bool> friday; in-out property <bool> saturday; in-out property <bool> sunday;
    callback toggle(); callback save(); callback show(int); callback check-update();

    VerticalLayout { padding: 10px; spacing: 8px;
        if root.page == 0: VerticalLayout { alignment: center; spacing: 8px;
            Rectangle { width: 170px; height: 170px; border-radius: 85px; background: control.pressed ? #dddddd : #f2f2f2;
                Text { text: root.running ? "❚❚" : "▶"; font-size: 74px; color: root.running ? #f29b38 : #269c45; horizontal-alignment: center; vertical-alignment: center; }
                control := TouchArea { clicked => { root.toggle(); } }
            }
            Text { text: root.elapsed; font-size: 28px; horizontal-alignment: center; }
        }
        if root.page == 1: VerticalLayout { spacing: 5px;
            LineEdit { text <=> root.api-token; input-type: password; placeholder-text: "API Token"; }
            LineEdit { text <=> root.api-url; placeholder-text: "API URL"; }
            LineEdit { text <=> root.project; placeholder-text: "Project"; }
            LineEdit { text <=> root.activity; placeholder-text: "Activity"; }
            LineEdit { text <=> root.week-hours; placeholder-text: "Hours per week"; }
            LineEdit { text <=> root.work-start; placeholder-text: "YYYY-MM-DD"; }
            HorizontalLayout { CheckBox { text: "Mo"; checked <=> root.monday; } CheckBox { text: "Tu"; checked <=> root.tuesday; } CheckBox { text: "We"; checked <=> root.wednesday; } CheckBox { text: "Th"; checked <=> root.thursday; } }
            HorizontalLayout { CheckBox { text: "Fr"; checked <=> root.friday; } CheckBox { text: "Sa"; checked <=> root.saturday; } CheckBox { text: "Su"; checked <=> root.sunday; } }
            Button { text: "Save"; primary: true; clicked => { root.save(); } }
        }
        Text { text: root.status; wrap: word-wrap; horizontal-alignment: center; }
        HorizontalLayout { alignment: center; spacing: 12px;
            IconButton { icon: root.running ? "❚❚" : "▶"; clicked => { root.show(0); } }
            IconButton { icon: "⚙"; clicked => { root.show(1); } }
            IconButton { icon: "↻"; clicked => { root.check-update(); } }
        }
    }
}
